<section class="section projects" id="projects">
  <div class="container">
    <div class="section__header section__header--projects">
      <h2 class="section__title">Featured Projects</h2>
      <a href="#" class="section__link">View All Projects &rarr;</a>
    </div>

    <div class="projects__grid">
      <article class="project-card">
        <div class="project-card__image-wrap">
          <%= image_tag "projects/flowcrm.jpg", alt: "FlowCRM", class: "project-card__image" %>
          <span class="project-card__badge project-card__badge--saas">SaaS</span>
        </div>
        <div class="project-card__body">
          <h3 class="project-card__title">FlowCRM</h3>
          <p class="project-card__description">
            A comprehensive CRM platform for managing customer relationships, sales pipelines,
            and team collaboration with real-time analytics.
          </p>
          <div class="project-card__tags">
            <span class="tag">Rails</span>
            <span class="tag">React</span>
            <span class="tag">PostgreSQL</span>
          </div>
          <a href="#" class="project-card__link">View Project &rarr;</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-card__image-wrap">
          <%= image_tag "projects/shoppex.jpg", alt: "ShoppeX", class: "project-card__image" %>
          <span class="project-card__badge project-card__badge--ecommerce">E-commerce</span>
        </div>
        <div class="project-card__body">
          <h3 class="project-card__title">ShoppeX</h3>
          <p class="project-card__description">
            Full-featured e-commerce platform with inventory management, payment processing,
            and multi-vendor marketplace capabilities.
          </p>
          <div class="project-card__tags">
            <span class="tag">Rails</span>
            <span class="tag">Sidekiq</span>
            <span class="tag">Redis</span>
          </div>
          <a href="#" class="project-card__link">View Project &rarr;</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-card__image-wrap">
          <%= image_tag "projects/insightpro.jpg", alt: "InsightPro", class: "project-card__image" %>
          <span class="project-card__badge project-card__badge--analytics">Analytics</span>
        </div>
        <div class="project-card__body">
          <h3 class="project-card__title">InsightPro</h3>
          <p class="project-card__description">
            Business intelligence dashboard with custom reporting, data visualization,
            and automated insights for data-driven decisions.
          </p>
          <div class="project-card__tags">
            <span class="tag">Rails</span>
            <span class="tag">React</span>
            <span class="tag">AWS</span>
          </div>
          <a href="#" class="project-card__link">View Project &rarr;</a>
        </div>
      </article>
    </div>
  </div>
</section>
